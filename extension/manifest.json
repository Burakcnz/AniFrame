{
  "key": "",
  "manifest_version": 3,
  "name": "AniFrame Video Downloader",
  "version": "2.8",
  "description": "IDM benzeri video algilama ve indirme - sayfalardaki videolari bulur ve AniFrame ile indirir",
  "homepage_url": "http://localhost:8000",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "webRequest",
    "alarms",
    "cookies"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "lib/utils.js",
      "lib/state.js",
      "lib/filter.js",
      "lib/parser.js",
      "lib/detector.js",
      "lib/ui.js",
      "lib/logger.js",
      "lib/api.js",
      "content.js"
    ],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AniFrame Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [{
    "resources": ["icons/*.png"],
    "matches": ["<all_urls>"]
  }],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+A" },
      "description": "AniFrame popup ac"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Ctrl+Shift+D" },
      "description": "Indirme panelini ac/kapa"
    },
    "download-all": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Tum videolari indir"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
